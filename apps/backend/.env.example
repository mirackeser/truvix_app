# Truvix backend configuration.
# Copy to .env and adjust for your machine. Never commit the resulting .env.

# --- Application ---
TRUVIX_ENVIRONMENT=development
TRUVIX_APP_NAME=Truvix API
TRUVIX_API_V1_PREFIX=/api/v1

# JSON arrays. In staging and production these must list explicit values;
# the wildcard below is rejected at startup outside development.
TRUVIX_TRUSTED_HOSTS=["*"]
TRUVIX_CORS_ALLOWED_ORIGINS=[]

# --- PostgreSQL ---
TRUVIX_DB_DSN=postgresql+asyncpg://truvix:truvix@localhost:5432/truvix
TRUVIX_DB_POOL_SIZE=10
TRUVIX_DB_MAX_OVERFLOW=20
TRUVIX_DB_ECHO_SQL=false
TRUVIX_DB_STATEMENT_TIMEOUT_SECONDS=30

# --- Redis ---
TRUVIX_REDIS_DSN=redis://localhost:6379/0
TRUVIX_REDIS_MAX_CONNECTIONS=50

# --- Security ---
# Generate with: python -c "from truvix.shared.config import generate_secret_key; print(generate_secret_key())"
TRUVIX_SECURITY_SECRET_KEY=
TRUVIX_SECURITY_ACCESS_TOKEN_TTL_MINUTES=30
TRUVIX_SECURITY_REFRESH_TOKEN_TTL_DAYS=30
TRUVIX_SECURITY_MAX_FAILED_LOGIN_ATTEMPTS=5
TRUVIX_SECURITY_ACCOUNT_LOCKOUT_MINUTES=15

# --- Rate limiting ---
TRUVIX_RATELIMIT_ENABLED=true
TRUVIX_RATELIMIT_AUTHENTICATED_REQUESTS_PER_MINUTE=120
TRUVIX_RATELIMIT_ANONYMOUS_REQUESTS_PER_MINUTE=30
TRUVIX_RATELIMIT_AUTH_ENDPOINT_REQUESTS_PER_MINUTE=10

# --- Observability ---
TRUVIX_OBS_LOG_LEVEL=INFO
# json in deployed environments, console for readable local output
TRUVIX_OBS_LOG_FORMAT=console
TRUVIX_OBS_SLOW_REQUEST_THRESHOLD_MS=1000
TRUVIX_OBS_SENTRY_DSN=
