# Truvix AI Service Configuration

# Environment (dev/test/staging/prod)
TRUVIX_AI_ENVIRONMENT=dev

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
TRUVIX_AI_LOG_LEVEL=INFO
# Log Format (json, console)
TRUVIX_AI_LOG_FORMAT=console

# Sentry DSN for error reporting (optional)
TRUVIX_AI_SENTRY_DSN=

# Secret API Key for the AI Provider (e.g., OpenAI)
TRUVIX_AI_PROVIDER_API_KEY=
# Base URL for the AI Provider API
TRUVIX_AI_PROVIDER_BASE_URL=https://api.openai.com/v1
# Model to use for chat completions
TRUVIX_AI_PROVIDER_MODEL=gpt-4o-mini
# Temperature for generation (0.0 to 2.0)
TRUVIX_AI_PROVIDER_TEMPERATURE=0.3
# Maximum tokens in the output
TRUVIX_AI_PROVIDER_MAX_OUTPUT_TOKENS=1024
# Timeout for API requests in seconds
TRUVIX_AI_PROVIDER_REQUEST_TIMEOUT_SECONDS=30
# Model to use for embeddings
TRUVIX_AI_PROVIDER_EMBEDDINGS_MODEL=text-embedding-3-small

# Host for ChromaDB
TRUVIX_AI_VECTOR_STORE_CHROMA_HOST=localhost
# Port for ChromaDB
TRUVIX_AI_VECTOR_STORE_CHROMA_PORT=8000
# Collection name for vehicles
TRUVIX_AI_VECTOR_STORE_COLLECTION_NAME=truvix_vehicles

# Maximum characters allowed in text input
TRUVIX_AI_GUARDRAILS_MAX_INPUT_CHARS=4000
# Maximum number of photos allowed in a single request
TRUVIX_AI_GUARDRAILS_MAX_PHOTOS=12
